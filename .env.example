# Autogen modules (comma-separated). Examples: pandas,sklearn,numpy,matplotlib
PYFLOWS_AUTOGEN_MODULES=pandas,sklearn,numpy
# Regex for including symbol names during introspection
PYFLOWS_AUTOGEN_INCLUDE=.*
# Regex for excluding symbol names (default hides private members)
PYFLOWS_AUTOGEN_EXCLUDE=^_
# Per-module node cap
PYFLOWS_AUTOGEN_LIMIT=100
# Cache TTL (seconds)
PYFLOWS_AUTOGEN_TTL=600

# Pip install timeout (seconds)
PYFLOWS_PIP_TIMEOUT=300

# Optional API token (when set, auth is required)
# PYFLOWS_API_TOKEN=change-me

# Kernel feature gate (overrides license placeholder)
# PYFLOWS_ENABLE_KERNEL=true

# Optional Jupyter Enterprise Gateway (Enterprise)
# JUPYTER_GATEWAY_URL=
# JUPYTER_GATEWAY_AUTH_TOKEN=
